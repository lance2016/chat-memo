# Docker Compose 的宿主机访问配置。容器内部仍使用 api:8000、frontend:3000。
# 修改端口后无需再同步改 docker-compose.yml。
PUBLIC_HOST=localhost
API_PORT=18000
FRONTEND_PORT=13000

# Compose 默认让浏览器请求前端的 /backend，再由前端容器通过服务名访问 API。
NEXT_PUBLIC_API_BASE_URL=/backend
INTERNAL_API_BASE_URL=http://api:8000

DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chat

# 助手怎么称呼你，会写进 system prompt
OWNER_NAME=用户

# 你手写的指令，原样追加到 system prompt 末尾，优先级高于默认人格。
# 和记忆的区别：这段只有你能改，每日整理不会碰它。一般在设置页里改，不用动这里。
CUSTOM_INSTRUCTIONS=

# anthropic | deepseek
PROVIDER=deepseek

ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-opus-5

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=4000

# 留空则不校验；设置后所有 /api 请求需带 X-API-Key 头
API_KEY=

# 同源代理模式不依赖 CORS；保留它是为了允许浏览器直接访问 API_PORT 调试。
CORS_ORIGINS=["http://${PUBLIC_HOST}:${FRONTEND_PORT}"]

# 是否思考。会话级可用 PATCH /api/conversations/{id} 覆盖
DEEPSEEK_THINKING=true

# 自动每日整理默认关闭：进程重启会重置计时器，笔记本凌晨多半在睡眠，
# 很容易整天不触发。用 POST /api/jobs/consolidate 手动整理更可靠。
CONSOLIDATE_AUTO=false
CONSOLIDATE_HOUR=4
# 整理专用模型。整理对质量最敏感、频率最低，值得用更好的；留空则和聊天同一个
CONSOLIDATE_MODEL=

# 容器时区。不设的话容器是 UTC，「今天」的判断会差 8 小时
TZ=Asia/Shanghai

# Obsidian vault 的宿主机绝对路径，留空则不启用知识库工具（kb_search / kb_read 等）。
# 只读挂载，模型改不了笔记。不用 Docker 直接跑后端时，这里就是 vault 的真实路径。
# iCloud 同步的库注意：没下载到本地的文件（云端占位）容器里读不到。
VAULT_PATH=

# 本地文字转语音服务（mlx-audio）。容器里连宿主机要用 host.docker.internal，
# compose 已经帮你覆盖成它了，这行是给「不用 Docker 直接跑后端」用的。
TTS_BASE_URL=http://127.0.0.1:8001
# off = 只出文字 | manual = 消息旁给播放按钮 | auto = 边写边读
# 这几项也能在设置页改，改完立刻生效（TTS_BASE_URL 除外）
TTS_MODE=off
# 启动时合成一个字，把模型权重加载进 MLX。不预热的话这十几秒会算在
# 用户第一次点播放的头上。语音服务没起来时静默跳过，不影响后端启动。
TTS_WARMUP=true

# 记录每次发给模型的完整请求体，供 /api/debug/requests 查、日志里打轮廓。
# 设置页也能开。开着会把完整对话历史留在进程内存里，排查完记得关。
DEBUG_PROMPTS=false

LOG_LEVEL=INFO
LOG_COLOR=true
# HTTP 访问日志。聊天已有独立的叙事日志，嫌吵可以设 false
LOG_ACCESS=true
