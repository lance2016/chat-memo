# 只填写启动所需的密钥、连接地址和宿主机路径。
# 模型、助手规则、记忆整理、通知、TTS/ASR 偏好等，请在设置页修改。

# PostgreSQL。Docker Compose 会自动把容器内地址覆盖为 db:5432；直跑后端时使用下面的宿主机地址。
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chat

# 至少填写当前 PROVIDER 对应的 key；也可以同时配置多个 provider，再在设置页切换。
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=

# OpenAI Responses API。可指向本机 CLIProxyAPI 的 Codex 代理：
# OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# OPENAI_API_KEY=sk-your-local-cliproxyapi-key
# 通常不需要 OPENAI_MODEL：模型会自动进入目录，再从设置页选择默认模型。
# OPENAI_MODELS=gpt-5.4,gpt-5.6-luna,codex-auto-review,gpt-image-1.5,gpt-5.4-mini,gpt-5.5,gpt-5.6-sol,gpt-5.6-terra,gpt-image-2,gpt-5.3-codex-spark

# 标题/通知使用的可选模型服务。没有这些 key 时会自动退回聊天模型或模板。
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=

# 联网搜索：在聊天输入框打开「联网搜索」后才会使用。
TAVILY_API_KEY=

# 留空则不校验；设置后所有 /api 请求需带 X-API-Key 头。
API_KEY=

# 容器时区。不设时默认使用代码中的 Asia/Shanghai。
TZ=Asia/Shanghai

# Compose 默认开启后端热重载，直接 `docker compose up -d` 即可开发。
# 生产或需要稳定运行后台 ticker 时再显式设为 0：RELOAD=0
# JOBS_ENABLED=0 仅用于临时调试后台任务，通常不需要改。
# RELOAD=0

# Obsidian vault 的宿主机绝对路径；留空则不启用只读知识库工具。
VAULT_PATH=

# 技能（Agent Skills）目录的宿主机路径，默认是仓库里的 ./skills。
# 和 vault 不同，这个目录必须可写 —— 安装技能就是往里面解压。
# 容器内固定挂到 /skills；留空则整个技能功能关闭。
# SKILLS_HOST_DIR=./skills

# 附件（上传的图片）正文的宿主机路径，默认是仓库里的 ./attachments。
# 正文不进数据库：pg_dump 是备份主路径，blob 塞进去会被份数轮换乘一遍。
# 容器内固定挂到 /attachments，必须可写。
# ATTACHMENTS_HOST_DIR=./attachments

# 本地 mlx-audio 服务地址。Docker Compose 会默认改成 host.docker.internal:8001。
# TTS_MODE、模型、音色、语速、ASR 语言等请在设置页修改。
TTS_BASE_URL=http://127.0.0.1:8001

# 可观测性不需要配置：Phoenix 随 compose 常起，链路记录默认打开。
# 开关和「是否保存对话正文」都在设置页里，改完立刻生效。
# 只有换端口或换上报地址时才需要这两项：
# PHOENIX_PORT=16006
# PHOENIX_RETENTION_DAYS=14

# 备份落到哪。**默认和数据同一块盘，磁盘坏了一起走** —— 强烈建议指到别处。
# 容器内的路径固定是 /backups，这里配的是宿主机路径。
# BACKUP_HOST_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/chat-memo-backups
