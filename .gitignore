# ---- 密钥 ----
# .env 里有 ANTHROPIC_API_KEY / DEEPSEEK_API_KEY，绝不能提交。
# 需要新增配置项时改 .env.example（那份只放占位符）。
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- 前端 ----
# frontend/ 下另有一份 .gitignore，这里是兜底
node_modules/
.next/
.next-dev/
.next-build/
out/
*.tsbuildinfo

# ---- 数据与备份 ----
# 记忆和对话都在 Docker 卷里，不该进仓库
*.sql
*.dump
backups/
# 未设置 VAULT_PATH 时 compose 挂的空占位目录
.vault-placeholder/

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp

# 评测产出：每次跑都会新增，不进版本库
eval-runs/

# ---- 附件 ----
# 上传的图片，属于本机数据。文件名是 sha256，没有可读性也不该进仓库。
# ⚠️ 前导斜杠不能省：不带斜杠的 `attachments/` 匹配任意层级，会把
# `app/attachments/`（附件功能的源码包）一起吞掉，而且是静默的 ——
# 症状是那个包一直显示「未修改」，实际从没被提交过。
/attachments/

# ---- 技能 ----
# 技能装在这里，属于本机数据，不进版本库（README 除外）。
skills/*
!skills/README.md
