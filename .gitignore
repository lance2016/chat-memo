# ---- 密钥 ----
# .env 里有 ANTHROPIC_API_KEY / DEEPSEEK_API_KEY，绝不能提交。
# 需要新增配置项时改 .env.example（那份只放占位符）。
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- 前端 ----
# frontend/ 下另有一份 .gitignore，这里是兜底
node_modules/
.next/
.next-dev/
.next-build/
out/
*.tsbuildinfo

# ---- 数据与备份 ----
# 记忆和对话都在 Docker 卷里，不该进仓库
*.sql
*.dump
backups/
# 未设置 VAULT_PATH 时 compose 挂的空占位目录
.vault-placeholder/

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp
