# Docker Compose 的宿主机访问配置。容器内部仍使用 api:8000、frontend:3000。
# 修改端口后无需再同步改 docker-compose.yml。
PUBLIC_HOST=localhost
API_PORT=18000
FRONTEND_PORT=13000

# Compose 默认让浏览器请求前端的 /backend，再由前端容器通过服务名访问 API。
NEXT_PUBLIC_API_BASE_URL=/backend
INTERNAL_API_BASE_URL=http://api:8000

DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chat

# 助手怎么称呼你，会写进 system prompt
OWNER_NAME=用户

# 你手写的指令，原样追加到 system prompt 末尾，优先级高于默认人格。
# 和记忆的区别：这段只有你能改，每日整理不会碰它。一般在设置页里改，不用动这里。
CUSTOM_INSTRUCTIONS=

# anthropic | deepseek
PROVIDER=deepseek

ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-opus-5

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=4000

# 留空则不校验；设置后所有 /api 请求需带 X-API-Key 头
API_KEY=

# 同源代理模式不依赖 CORS；保留它是为了允许浏览器直接访问 API_PORT 调试。
CORS_ORIGINS=["http://${PUBLIC_HOST}:${FRONTEND_PORT}"]

# 是否思考。会话级可用 PATCH /api/conversations/{id} 覆盖
DEEPSEEK_THINKING=true

# 每轮发给模型的历史字符预算，超出就从最老的一端丢整轮。没有上限的话，长会话
# 会一直线性膨胀，最终撞上下文窗口 —— 那之后该会话每条消息都 400，等于永久损坏。
# 12 万字符对中文约合 8～10 万 token，给 128k 窗口留足了 system prompt 和输出的余量。
# 换到窗口更小的模型时要跟着调小。
HISTORY_MAX_CHARS=120000

# 自动每日整理默认关闭：进程重启会重置计时器，笔记本凌晨多半在睡眠，
# 很容易整天不触发。用 POST /api/jobs/consolidate 手动整理更可靠。
CONSOLIDATE_AUTO=false
CONSOLIDATE_HOUR=4
# 整理专用模型。整理对质量最敏感、频率最低，值得用更好的；留空则和聊天同一个
CONSOLIDATE_MODEL=

# 标题专用模型，优先走硅基流动的免费 Qwen3-8B（OpenAI 兼容接口）。
# 标题是「一句话概括用户想干什么」，要的是快 —— 用聊天模型做这件事会为十几个字
# 烧掉几百个思考 token、拖上好几秒，而且标题还更差。
# 会显式关闭 Qwen3 思考；留空 KEY 则兼容下面的智谱配置，再否则退回聊天 provider。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TITLE_MODEL=Qwen/Qwen3-8B

# 旧的智谱标题配置仍然兼容；新部署可以保持为空。
ZHIPU_API_KEY=
TITLE_MODEL=glm-4.7-flash

# 容器时区。不设的话容器是 UTC，「今天」的判断会差 8 小时
TZ=Asia/Shanghai

# Obsidian vault 的宿主机绝对路径，留空则不启用知识库工具（kb_search / kb_read 等）。
# 只读挂载，模型改不了笔记。不用 Docker 直接跑后端时，这里就是 vault 的真实路径。
# iCloud 同步的库注意：没下载到本地的文件（云端占位）容器里读不到。
VAULT_PATH=

# ---- 主动通知：到点了把时间事项推到手机上 ----
# 下面这些也能在设置页改，改完下一分钟就生效，不用重启。
# 默认关。先在设置页把 Bark 测通，再打开这个开关。
NOTIFY_ENABLED=false
# 启用的通道，逗号分隔。目前只支持 bark。
NOTIFY_CHANNELS=bark
# 每天早上一条：今天有什么、什么逾期了、什么待确认挂太久了。
NOTIFY_BRIEFING=true
NOTIFY_BRIEFING_HOUR=8
# 全天事项（生日、整天有效的待办）按当天几点提醒。它们的开始时间是当地 00:00，
# 不换算的话提醒会落在半夜。
NOTIFY_ALL_DAY_HOUR=9
# 类型没有默认提前量时用这个。会议 15 分钟、出行和生日提前一天、截止日期提前三天
# 是按 kind 内置的，见 app/notify/schedule.py。
NOTIFY_DEFAULT_LEAD_MINUTES=15
# 补发窗口：开始时间已经过去这么久的事项不再单独推，交给每日简报兜底。
# 没有这道闸，离线一周后一开机会被一周的提醒糊满屏幕。
NOTIFY_CATCHUP_HOURS=6
# 用便宜的标题模型把提醒写成人话（「十五分钟后开会，上次你说想提重复检测」）。
# 关掉就用模板。没配 SILICONFLOW_API_KEY 时自动退回模板。
NOTIFY_SMART_COPY=true
# 通知点开后跳到哪。手机点不开 localhost，要填局域网或公网地址，
# 例如 http://192.168.1.10:13000。留空则通知不带链接。
NOTIFY_PUBLIC_BASE_URL=
# Bark（iOS）：App Store 装 Bark，打开就能看到设备 key，粘到这里或设置页。
BARK_SERVER=https://api.day.app
BARK_KEY=
# 留空用 Bark 默认提示音。
BARK_SOUND=
# 通知左侧的图标，必须是手机能访问到的 URL。
BARK_ICON=

# 本地文字转语音服务（mlx-audio）。容器里连宿主机要用 host.docker.internal，
# compose 通过下面单独的 Docker 地址覆盖；这行给「不用 Docker 直跑后端」使用。
TTS_BASE_URL=http://127.0.0.1:8001
# API 在容器里运行时访问宿主机 TTS 的地址。一般无需修改。
TTS_DOCKER_BASE_URL=http://host.docker.internal:8001
# 后端直跑时留空即可自动读取 ~/.cache/huggingface/hub；Compose 已自动只读挂载。
TTS_MODEL_CACHE=
# off = 只出文字 | manual = 消息旁给播放按钮 | auto = 边写边读
# 这几项也能在设置页改，改完立刻生效（TTS_BASE_URL 除外）
TTS_MODE=off
# 启动时合成一个字，把模型权重加载进 MLX。不预热的话这十几秒会算在
# 用户第一次点播放的头上。语音服务没起来时静默跳过，不影响后端启动。
TTS_WARMUP=true
# 语音输入复用上面的 mlx-audio 地址，不受 TTS_MODE 开关影响。
ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
ASR_LANGUAGE=Chinese
ASR_MAX_TOKENS=512
ASR_MAX_BYTES=26214400
ASR_TIMEOUT=180

# 只用于 Docker 构建 Python 依赖；国内网络默认走清华镜像。
# 如需官方 PyPI：UV_DEFAULT_INDEX=https://pypi.org/simple
UV_DEFAULT_INDEX=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple/

# 记录每次发给模型的完整请求体，供 /api/debug/requests 查、日志里打轮廓。
# 设置页也能开。开着会把完整对话历史留在进程内存里，排查完记得关。
DEBUG_PROMPTS=false

LOG_LEVEL=INFO
LOG_COLOR=true
# HTTP 访问日志。聊天已有独立的叙事日志，嫌吵可以设 false
LOG_ACCESS=true
